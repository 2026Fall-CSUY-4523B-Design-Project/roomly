# /srv/roomly/.env — read by docker compose, owned by root, mode 0640 root:roomly-deploy.
# The tag is not here: deploy.sh passes TAG in the environment so this file never changes.

# ghcr.io/2026fall-csuy-4523b-design-project; both packages must be public for anonymous pulls.
IMAGE_PREFIX=ghcr.io/2026fall-csuy-4523b-design-project

# Use a URL-safe password (letters and digits): it is interpolated into DATABASE_URL.
POSTGRES_USER=roomly
POSTGRES_PASSWORD=CHANGE_ME_alphanumeric_only
POSTGRES_DB=roomly

# Same value as the mail Worker's MAIL_SECRET (`wrangler secret put MAIL_SECRET --env production`).
ROOMLY_MAIL_SECRET=CHANGE_ME
ROOMLY_APP_URL=https://roomly.bid
ROOMLY_MAIL_URL=https://mail.roomly.bid
