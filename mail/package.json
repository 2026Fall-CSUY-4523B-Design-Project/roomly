{
  "name": "roomly-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roomly transactional mail and inbound routing on Cloudflare Workers",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail:production": "wrangler tail --env production"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
