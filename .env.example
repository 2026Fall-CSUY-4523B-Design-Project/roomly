# Backend (copy to .env and export, or set in your deploy environment)
ROOMLY_ENV=dev                # dev | prod
# ROOMLY_HOST=127.0.0.1       # prod default: 0.0.0.0
# ROOMLY_PORT=8000
# ROOMLY_LOG_LEVEL=DEBUG      # prod default: INFO
# DATABASE_URL=postgresql://roomly@127.0.0.1:5433/postgres   # required when ROOMLY_ENV=prod

# Frontend (read by next.config.js at build/start time)
# ROOMLY_API_URL=http://127.0.0.1:8000
# SQLite file used when Postgres is unreachable at startup (dev default db/roomly.sqlite3, prod default off; "off" disables)
# ROOMLY_SQLITE_FALLBACK=
# Migrations root holding postgres/ and sqlite/ (defaults to the repo's db/migrations)
# ROOMLY_MIGRATIONS_DIR=
# Stub endpoints answer with sample responses instead of 501 (dev default on, prod default off)
# ROOMLY_FIXTURES=
